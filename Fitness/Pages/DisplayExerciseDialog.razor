@using Fitness.Models
<MudDialog DefaultFocus="@(IsNewExercise ? DefaultFocus.None : (DefaultFocus?)null)">
  <TitleContent>@DialogTitle</TitleContent>
  <DialogContent>
    <MudForm @ref="Form">
      <MudGrid Spacing="12">
        <MudItem xs="12">
          <MudTextField T="string" Label="Exercise Name" Class="uppercase-input" AutoFocus="IsNewExercise" Immediate="true" Value="Exercise.Name" ValueChanged="@((string value) => Exercise.Name = value?.ToUpper() ?? string.Empty)" For="(() => Exercise.Name)" />
        </MudItem>
        <MudItem xs="12">
          <MudTextField T="int?" Mask="@(new PatternMask("000"))" Label="Weight" @bind-Value="Exercise.Weight" For="(() => Exercise.Weight)" />
        </MudItem>
        <MudItem xs="12">
          <MudSelect Label="Units of Measurement" @bind-Value="Exercise.Measurement" For="(() => Exercise.Measurement)">
            @foreach (Exercise.WeightType item in Enum.GetValues(typeof(Exercise.WeightType)))
            {
              <MudSelectItem Value="@item">@item</MudSelectItem>
            }
          </MudSelect>
        </MudItem>
        <MudItem xs="12">
          <MudCheckBox T="bool" Class="aligned-checkbox" Label="Use Rep Range" Value="UseRepRange" ValueChanged="SetUseRepRange" />
        </MudItem>
        @if (UseRepRange)
        {
          <MudItem xs="12">
            <MudTextField T="int?" Mask="@(new PatternMask("00"))" Label="Min Reps" @bind-Value="Exercise.MinReps" @bind-Value:after="ClearMaxRepsError" For="(() => Exercise.MinReps)" />
          </MudItem>
          <MudItem xs="12">
            <MudTextField @ref="MaxRepsField" T="int?" Mask="@(new PatternMask("00"))" Label="Max Reps" @bind-Value="Exercise.MaxReps" For="(() => Exercise.MaxReps)" Validation="@(new Func<int?, string?>(ValidateMaxReps))" />
          </MudItem>
        }
        else
        {
          <MudItem xs="12">
            <MudTextField T="int?" Mask="@(new PatternMask("00"))" Label="Reps" Value="Reps" ValueChanged="SetReps" Validation="@(new Func<int?, string?>(ValidateReps))" />
          </MudItem>
        }
        <MudItem xs="12">
          <MudTextField T="int" Mask="@(new PatternMask("0"))" Label="Sets" @bind-Value="Exercise.Sets" For="(() => Exercise.Sets)" />
        </MudItem>
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
          <MudItem xs="12">
            <MudText Align="Align.Center" Color="Color.Error">@ErrorMessage</MudText>
          </MudItem>
        }
      </MudGrid>
    </MudForm>
  </DialogContent>
  <DialogActions>
    <span @onmousedown:preventDefault="true"><MudButton OnClick="Cancel">Cancel</MudButton></span>
    @if (!string.IsNullOrWhiteSpace(UnmodifiedExercise.Name))
    {
      <MudButton Variant="Variant.Filled" DropShadow="false" Color="Color.Primary" OnClick="DeleteExercise" aria-label="Delete Exercise"><MudIcon Icon="@Icons.Material.Filled.Delete" /></MudButton>
    }
    @if (CheckExerciseIsModified())
    {
      <MudButton Variant="Variant.Filled" DropShadow="false" Color="Color.Primary" OnClick="Submit" aria-label="Submit"><MudIcon Icon="@Icons.Material.Filled.Check" /></MudButton>
    }
  </DialogActions>
</MudDialog>