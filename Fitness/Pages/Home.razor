@page "/"

<PageTitle>Fitness</PageTitle>

@if (IsStorageLoaded)
{
  <MudContainer Class="@(IsWorkoutLoaded ? "mt-3" : "workout-empty-state")" MaxWidth="MaxWidth.Large">
    <MudText Typo="Typo.h3" Align="Align.Center" GutterBottom="false">Workout</MudText>
    <MudContainer Class="d-flex justify-center">
      <MudButton Variant="Variant.Filled" DropShadow="false" Color="Color.Primary" Size="Size.Large" Class="@(IsWorkoutLoaded ? "mt-3 mb-8" : "mt-3")" OnClick="LoadWorkout">Load Workout</MudButton>
    </MudContainer>
    @if (IsWorkoutLoaded)
    {
      <MudStack Row Class="mb-2">
        <MudText Typo="Typo.h5">Session Type: @Storage.CurrentWorkout.SessionType</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" DropShadow="false" Color="Color.Primary" Size="Size.Large" OnClick="ExpandSessionOptions"><MudIcon Icon="@Icons.Material.Filled.MoreVert" /></MudButton>
      </MudStack>
      <MudCollapse Expanded="IsExpandSessionOptions" Class="mb-6">
        <MudStack Row>
          <MudButton Variant="Variant.Filled" DropShadow="false" Color="Color.Primary" Size="Size.Large" OnClick="DeleteSessionTypeData"><MudIcon Icon="@Icons.Material.Filled.Delete" /></MudButton>
          <MudSpacer />
          <MudButton Variant="Variant.Filled" DropShadow="false" Color="Color.Primary" Size="Size.Large" OnClick="AddOneRepToAllInCurrentWorkout"><b>+1 Rep</b></MudButton>
          <MudButton Variant="Variant.Filled" DropShadow="false" Color="Color.Primary" Size="Size.Large" OnClick="ShowCurrentWorkoutAsText"><MudIcon Icon="@Icons.Material.Filled.TextSnippet" /></MudButton>
        </MudStack>
      </MudCollapse>
      <MudGrid Spacing="12">
        <MudItem xs="12">
          <MudDataGrid Items="@Storage.CurrentWorkout.Exercises" SortMode="@SortMode.None" Breakpoint="Breakpoint.Always" Class="exercise-datagrid">
            <ToolBarContent>
              <MudText Typo="Typo.h6" Style="font-size: 1.375rem;">Current Workout</MudText>
              <MudSpacer />
              <MudButton Variant="Variant.Filled" DropShadow="false" Color="Color.Primary" Size="Size.Large" OnClick="AddExercise"><MudIcon Icon="@Icons.Material.Filled.Add" /></MudButton>
            </ToolBarContent>
            <Columns>
              <PropertyColumn Property="x => x.Name" Title="Exercise" CellClass="exercise-name-cell" />
              <PropertyColumn Property="x => x.FormatWeight()" Title="Weight" CellStyleFunc="@ChangedWeightCellStyleFunc" />
              <PropertyColumn Property="x => x.FormatReps()" Title="Reps" CellStyleFunc="@ChangedRepsCellStyleFunc" />
              <PropertyColumn Property="x => x.Sets" Title="Sets" />
              <TemplateColumn Context="row" Title="Completed Sets">
                <CellTemplate>
                  <MudRating ReadOnly="true" Size="@Size.Large" Color="Color.Primary" FullIcon="@Icons.Material.Filled.FitnessCenter" EmptyIcon="@Icons.Material.Outlined.CheckBoxOutlineBlank" MaxValue="@row.Item.Sets" SelectedValue="@row.Item.CompletedSets" />
                </CellTemplate>
              </TemplateColumn>
              <TemplateColumn Context="row" Title="Mark Complete">
                <CellTemplate>
                  <MudButton Variant="Variant.Filled" Size="Size.Medium" Color="Color.Primary" OnClick="(() => IncrementCompletedSet(row.Item))"><MudIcon Icon="@Icons.Material.Filled.FitnessCenter" /></MudButton>
                </CellTemplate>
              </TemplateColumn>
              <TemplateColumn Context="row" Title="Shortcuts">
                <CellTemplate>
                  <MudStack Row Spacing="2" Class="shortcut-buttons">
                    <MudButton Variant="Variant.Filled" Size="Size.Medium" Color="Color.Primary" Disabled="@(Storage.CurrentWorkout.Exercises.IndexOf(row.Item) <= 0)" OnClick="(() => MoveExercise(row.Item, -1))" aria-label="Move Up"><MudIcon Icon="@Icons.Material.Filled.ArrowUpward" /></MudButton>
                    <MudButton Variant="Variant.Filled" Size="Size.Medium" Color="Color.Primary" Disabled="@(Storage.CurrentWorkout.Exercises.IndexOf(row.Item) >= Storage.CurrentWorkout.Exercises.Count - 1)" OnClick="(() => MoveExercise(row.Item, 1))" aria-label="Move Down"><MudIcon Icon="@Icons.Material.Filled.ArrowDownward" /></MudButton>
                    <MudButton Variant="Variant.Filled" Size="Size.Medium" Color="Color.Primary" OnClick="(() => ResetToPreviousWorkout(row.Item))" aria-label="Reset To Prev"><MudIcon Icon="@Icons.Material.Filled.ArrowBack" /></MudButton>
                    <MudButton Variant="Variant.Filled" Size="Size.Medium" Color="Color.Primary" OnClick="(() => EditExercise(row.Item))" aria-label="Edit"><MudIcon Icon="@Icons.Material.Filled.Edit" /></MudButton>
                  </MudStack>
                </CellTemplate>
              </TemplateColumn>
              <TemplateColumn Context="row" Title="Increment">
                <CellTemplate>
                  <MudStack Row Spacing="2" Class="increment-buttons">
                    <MudButton Variant="Variant.Filled" Size="Size.Medium" Color="Color.Primary" Disabled="@(row.Item.Weight + 10 > MaxWeight)" OnClick="(() => IncrementWeight(row.Item, 10))">+10 @FormatUnits(row.Item)</MudButton>
                    <MudButton Variant="Variant.Filled" Size="Size.Medium" Color="Color.Primary" Disabled="@(row.Item.Weight + 5 > MaxWeight)" OnClick="(() => IncrementWeight(row.Item, 5))">+5 @FormatUnits(row.Item)</MudButton>
                    <MudButton Variant="Variant.Filled" Size="Size.Medium" Color="Color.Primary" Disabled="@(row.Item.MaxReps + 1 > MaxReps)" OnClick="(() => IncrementReps(row.Item))">+1 rep</MudButton>
                  </MudStack>
                </CellTemplate>
              </TemplateColumn>
            </Columns>
          </MudDataGrid>
        </MudItem>
        <MudItem xs="12" Class="d-flex justify-center">
          <MudButton Variant="Variant.Filled" DropShadow="false" Color="Color.Primary" Size="Size.Large" Class="mt-2" OnClick="SaveProgress">Save Progress</MudButton>
        </MudItem>
        <MudItem xs="12" Class="mb-20">
          <MudText Align="Align.Center" Color="Color.Success">@Notification</MudText>
        </MudItem>
        <MudItem xs="12" Class="mb-20" />
      </MudGrid>
    }
  </MudContainer>
}
