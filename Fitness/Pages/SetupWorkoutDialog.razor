@using Fitness.Models
<MudDialog DefaultFocus="DefaultFocus.None">
  <TitleContent>Setup @SessionType Workout</TitleContent>
  <DialogContent>
    <MudForm @ref="Form">
      <MudGrid Spacing="6">
        <MudItem xs="12">
          <MudTextField @ref="NameField" T="string" Label="Exercise Name" Class="uppercase-input" AutoFocus="true" Value="Exercise.Name" ValueChanged="@((string value) => Exercise.Name = value?.ToUpper() ?? string.Empty)" For="(() => Exercise.Name)" />
        </MudItem>
        <MudItem xs="12">
          <MudTextField T="int?" Mask="@(new PatternMask("000"))" Label="Weight" @bind-Value="Exercise.Weight" For="(() => Exercise.Weight)" />
        </MudItem>
        <MudItem xs="12">
          <MudSelect Label="Units of Measurement" @bind-Value="Exercise.Measurement" For="(() => Exercise.Measurement)">
            @foreach (Exercise.WeightType item in Enum.GetValues(typeof(Exercise.WeightType)))
            {
              <MudSelectItem Value="@item">@item</MudSelectItem>
            }
          </MudSelect>
        </MudItem>
        <MudItem xs="12">
          <MudCheckBox T="bool" Class="aligned-checkbox" Label="Use Rep Range" Value="UseRepRange" ValueChanged="SetUseRepRange" />
        </MudItem>
        @if (UseRepRange)
        {
          <MudItem xs="12">
            <MudTextField T="int?" Mask="@(new PatternMask("00"))" Label="Min Reps" @bind-Value="Exercise.MinReps" @bind-Value:after="ClearMaxRepsError" For="(() => Exercise.MinReps)" />
          </MudItem>
          <MudItem xs="12">
            <MudTextField @ref="MaxRepsField" T="int?" Mask="@(new PatternMask("00"))" Label="Max Reps" @bind-Value="Exercise.MaxReps" For="(() => Exercise.MaxReps)" Validation="@(new Func<int?, string?>(ValidateMaxReps))" />
          </MudItem>
        }
        else
        {
          <MudItem xs="12">
            <MudTextField T="int?" Mask="@(new PatternMask("00"))" Label="Reps" Value="Reps" ValueChanged="SetReps" Validation="@(new Func<int?, string?>(ValidateReps))" />
          </MudItem>
        }
        <MudItem xs="12">
          <MudTextField T="int" Mask="@(new PatternMask("0"))" Label="Sets" @bind-Value="Exercise.Sets" For="(() => Exercise.Sets)" />
        </MudItem>
        <MudItem xs="12">
          <MudContainer Class="d-flex justify-center">
            <MudButton Variant="Variant.Filled" DropShadow="false" Color="Color.Primary" Size="Size.Large" OnClick="AddExercise" aria-label="Add Exercise"><MudIcon Icon="@Icons.Material.Filled.Add" /></MudButton>
          </MudContainer>
        </MudItem>
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
          <MudItem xs="12">
            <MudText Align="Align.Center" Color="Color.Error">@ErrorMessage</MudText>
          </MudItem>
        }
        @if (ExerciseList.Count > 0)
        {
          <MudItem xs="12">
            <MudDataGrid Items="@ExerciseList" SortMode="@SortMode.None" Breakpoint="Breakpoint.Always">
              <ToolBarContent>
                <MudText Typo="Typo.h6">Setup Workout</MudText>
              </ToolBarContent>
              <Columns>
                <PropertyColumn Property="x => x.Name" Title="Exercise" CellClass="exercise-name-cell" />
                <PropertyColumn Property="x => x.FormatWeight()" Title="Weight" />
                <PropertyColumn Property="x => x.FormatReps()" Title="Reps" />
                <PropertyColumn Property="x => x.Sets" Title="Sets" />
                <TemplateColumn Context="row" Title="Actions">
                  <CellTemplate>
                    <MudStack Row>
                      <MudButton Size="@Size.Small" Variant="@Variant.Filled" Color="@Color.Primary" OnClick="(() => DeleteExercise(row.Item))">Delete</MudButton>
                    </MudStack>
                  </CellTemplate>
                </TemplateColumn>
              </Columns>
            </MudDataGrid>
          </MudItem>
        }
      </MudGrid>
    </MudForm>
  </DialogContent>
  <DialogActions>
    <span @onmousedown:preventDefault="true"><MudButton OnClick="Cancel">Cancel</MudButton></span>
    <MudButton Variant="Variant.Filled" DropShadow="false" Color="Color.Primary" OnClick="AddExercise" aria-label="Add Exercise"><MudIcon Icon="@Icons.Material.Filled.Add" /></MudButton>
    <span @onmousedown:preventDefault="true"><MudButton Variant="Variant.Filled" DropShadow="false" Color="Color.Primary" OnClick="Submit" aria-label="Submit"><MudIcon Icon="@Icons.Material.Filled.Check" /></MudButton></span>
  </DialogActions>
</MudDialog>